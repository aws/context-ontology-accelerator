openapitools.json

# Cached jars (openapi-generator)
.cache/

# Runtime artifacts from demo/setup.py and demo/demo.py (cached ontology
# downloads and per-induction outputs). Regenerated on each run.
/data/
/output/

# Local ontology-engine scratch output (cached ontology downloads + per-run
# induction dumps). Regenerated on each run; never checked in.
packages/ontology-engine/data/

# Agent orchestration metadata
AGENT_CONTEXT.md

# mise toolchain installs — CI sets MISE_INSTALL_PATH / MISE_DATA_DIR to
# $CI_PROJECT_DIR/.mise (see .gitlab-ci.yml), so `mise install` writes the
# Java/Node/Python/pnpm toolchains into the repo working tree. Ignoring them
# keeps git status clean and stops the vulnerability-resolver agent's
# changed-file detection from treating toolchain installs as repo changes.
.mise/

# Runtime resolver harness scripts copied into the workspace by CI before_script.
.claude/scripts/
packages/mcp-proxy/node_modules/

# Benchmark run artifacts (numbers belong in the MR/description, not the tree)
scripts/serve/eval_results/

# Provisioned namespace routing maps: UUIDs of namespaces in ONE account, written
# by benchmarks/**/setup/provision_ns.py. Checking them in would point another
# account's run at namespaces it does not own; re-run the provisioner instead.
benchmarks/*/questions/namespace_map.json
