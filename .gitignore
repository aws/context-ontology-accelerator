*.egg-info/
dist/
build/
.eggs/

# UV
.uv-cache/
.pip-cache/

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime log output. `logs/application.log` was committed once by accident;
# nothing in the repo reads or writes this path.
logs/

# MCP logs
.playwright-mcp

# pnpm
.pnpm-store

# Nx
.nx/

# CDK
cdk.out/
cdk.context.json

# Smithy codegen output (regenerated by make generate)
smithy-generated/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
*.pem

# Local dev runtime config (contains env-specific endpoints and credentials)
packages/web-app/public/runtime-config.json

# Vite build output (hashed chunks — never commit these)
public/assets/
public/index.html
public/favicon.svg

# Coverage
htmlcov/
.coverage
.coverage.*
**/coverage.xml
**/coverage/
**/junit.xml

# Playwright E2E artifacts and stored auth state
**/playwright-report/
**/test-results/
packages/web-app/tests/e2e/.auth/

# Docker
docker-compose.override.yml

# Gradle cache (Smithy codegen)
models/.gradle/

# OpenAPI Generator config (auto-created)
openapitools.json

# Cached jars (openapi-generator)
.cache/

# Runtime artifacts from demo/setup.py and demo/demo.py (cached ontology
# downloads and per-induction outputs). Regenerated on each run.
/data/
/output/

# Agent orchestration metadata
AGENT_CONTEXT.md

# mise toolchain installs — CI sets MISE_INSTALL_PATH / MISE_DATA_DIR to
# $CI_PROJECT_DIR/.mise (see .gitlab-ci.yml), so `mise install` writes the
# Java/Node/Python/pnpm toolchains into the repo working tree. Ignoring them
# keeps git status clean and stops the vulnerability-resolver agent's
# changed-file detection from treating toolchain installs as repo changes.
.mise/

# Runtime resolver harness scripts copied into the workspace by CI before_script.
.claude/scripts/
packages/mcp-proxy/node_modules/

# autoresearch loop run-trees (ephemeral: cursor, metric ledgers, per-iteration gap reports)
autoresearch/
docs/grounding/

