{
  "name": "coa-infra",
  "version": "0.3.1",
  "description": "SemanticContext CDK Infrastructure (TypeScript)",
  "private": true,
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "lint": "tsc --noEmit && uv run ruff check lambda lib/lambdas test && uv run ruff format --check lambda lib/lambdas test",
    "format": "prettier --write \"bin/**/*.ts\" \"lib/**/*.ts\"",
    "format:check": "prettier --check \"bin/**/*.ts\" \"lib/**/*.ts\"",
    "test": "jest --runInBand && uv run pytest test/lambdas -q",
    "cdk": "cdk"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1038.0",
    "@aws-sdk/client-datazone": "3.1038.0",
    "@aws-sdk/client-dynamodb": "3.1038.0",
    "@aws-sdk/client-ec2": "3.1038.0",
    "@aws-sdk/client-secrets-manager": "^3.1038.0",
    "@aws-sdk/client-ssm": "^3.1039.0",
    "@aws-sdk/lib-dynamodb": "3.1038.0",
    "@types/aws-lambda": "^8.10.161",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "aws-cdk": "^2.1127.0",
    "esbuild": "^0.28.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.21.0",
    "typescript": "~5.7.0"
  },
  "dependencies": {
    "@coa/shared": "workspace:*",
    "aws-cdk-lib": "^2.260.0",
    "cdk-monitoring-constructs": "10.2.0",
    "constructs": "^10.0.0"
  }
}
