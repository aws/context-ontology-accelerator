{
  "$schema": "https://raw.githubusercontent.com/nrwl/nx/master/packages/nx/schemas/nx-schema.json",
  "namedInputs": {
    "normalizationFixtures": [
      "{workspaceRoot}/tests/unit/fixtures/normalize-name-key.json"
    ],
    "default": [
      "{projectRoot}/**/*",
      "!{projectRoot}/**/*.md",
      "normalizationFixtures"
    ],
    "python": [
      "{projectRoot}/src/**/*.py",
      "{projectRoot}/tests/**/*.py",
      "{projectRoot}/pyproject.toml",
      "normalizationFixtures"
    ],
    "typescript": [
      "{projectRoot}/src/**/*.ts",
      "{projectRoot}/src/**/*.tsx",
      "{projectRoot}/tsconfig.json",
      "{projectRoot}/package.json",
      "normalizationFixtures"
    ],
    "smithyModels": ["{workspaceRoot}/models/**/*"]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "test": {
      "dependsOn": ["build"],
      "cache": true
    },
    "lint": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "format": {
      "cache": false
    }
  },
  "plugins": [
    {
      "plugin": "nx/plugins/package-json"
    }
  ]
}
