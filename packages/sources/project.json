{
  "name": "sources",
  "namedInputs": { "default": ["python"] },
  "implicitDependencies": ["common"],
  "targets": {
    "lint": {
      "command": "uv run ruff check packages/sources && uv run ruff format --check packages/sources && uv run mypy packages/sources/src --ignore-missing-imports --cache-dir packages/sources/.mypy_cache"
    },
    "test": {
      "inputs": ["default", "^default", "smithyModels"],
      "command": "COVERAGE_FILE=packages/sources/.coverage uv run pytest packages/sources/tests/unit -v --tb=short --cov=packages/sources/src --cov-report=term-missing --cov-report=xml:packages/sources/coverage.xml --cov-fail-under=80 --junitxml=packages/sources/junit.xml"
    },
    "format": {
      "command": "uv run ruff format packages/sources"
    },
    "format:check": {
      "command": "uv run ruff format --check packages/sources"
    }
  }
}
