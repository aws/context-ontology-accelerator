{
  "name": "coa-web-app",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src/ && prettier --check src/",
    "format": "eslint --fix src/ && prettier --write src/",
    "format:check": "prettier --check src/",
    "test": "vitest run --coverage",
    "test:e2e": "playwright test",
    "typecheck:e2e": "tsc -p tests/e2e/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@cloudscape-design/chat-components": "^1.0.139",
    "@cloudscape-design/collection-hooks": "^1.0.95",
    "@cloudscape-design/components": "^3.0.0",
    "@cloudscape-design/global-styles": "^1.0.0",
    "@dagrejs/dagre": "^3.0.0",
    "@coa/control-plane-client": "workspace:*",
    "@coa/data-layer-client": "workspace:*",
    "@coa/shared": "workspace:*",
    "@tanstack/react-query": "5.72.2",
    "@xyflow/react": "^12.11.0",
    "eventsource-parser": "^3.1.0",
    "marked": "^18.0.4",
    "oidc-client-ts": "^3.1.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-intersection-observer": "10.0.3",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.28.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.61.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/marked": "^6.0.0",
    "@types/node": "^22.19.21",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^20.9.0",
    "prettier": "3.8.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.59.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.6"
  }
}
